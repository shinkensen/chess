NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: restrict markets to specific Lichess game IDs (comma-separated).
# Leave unset to auto-create a market for every game seen on the Lichess TV feeds.
# FEATURED_LICHESS_GAME_IDS=

# Optional: NDJSON stream URLs to watch. Defaults to the main TV feed plus
# blitz, rapid, and classical channels.
# LICHESS_STREAM_URLS=https://lichess.org/api/tv/feed,https://lichess.org/api/tv/blitz/feed

# Optional: Stockfish executable for smarter bot evaluation. When unset, bots
# fall back to a built-in material evaluation.
# STOCKFISH_PATH=/usr/games/stockfish

# Optional: worker tuning
# WORKER_HOLDER_ID=11111111-1111-4111-8111-111111111111
# WORKER_LEASE_MS=30000
# RECONCILIATION_MS=15000
# STALE_AFTER_MS=60000

# Bot accounts are auto-provisioned on first worker start; generated passwords
# are stored in worker/.bot-credentials.json (gitignored). Override here only
# if you want specific accounts, e.g.
# BOT_ACCOUNTS_JSON=[{"personality":"Endgame Sage","email":"sage@example.com","password":"replace-me"}]
